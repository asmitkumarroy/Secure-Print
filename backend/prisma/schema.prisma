generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  uploaded
  printing
  printed
  expired
  deleted
}

enum PrintJobStatus {
  pending
  printing
  completed
  failed
}

enum ColorMode {
  bw
  color
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  documents Document[]
}

model Document {
  id            String         @id @default(cuid())
  userId        String?
  originalName  String
  mimeType      String
  fileSizeBytes Int
  storageKey    String
  tokenJti      String         @unique
  expiresAt     DateTime
  status        DocumentStatus @default(uploaded)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User?          @relation(fields: [userId], references: [id])
  printJobs     PrintJob[]

  @@index([expiresAt])
  @@index([status])
}

model Shop {
  id         String     @id @default(cuid())
  name       String
  location   String
  ownerEmail String     @unique
  createdAt  DateTime   @default(now())
  printJobs  PrintJob[]
}

model PrintJob {
  id         String         @id @default(cuid())
  documentId String
  shopId     String
  pages      Int
  copies     Int
  colorMode  ColorMode
  status     PrintJobStatus @default(pending)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  document   Document       @relation(fields: [documentId], references: [id])
  shop       Shop           @relation(fields: [shopId], references: [id])

  @@index([documentId])
  @@index([shopId])
}
